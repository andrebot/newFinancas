# Copy to .env (git-ignored) and adjust. Local development only (OQ-88).

# --- API ---------------------------------------------------------------
PORT=3000
# Email channel provider of NotificationDeliveryUtility (OQ-84/OQ-88).
# `console` prints emails to the log; it is the only provider in v1.
EMAIL_PROVIDER=console
# The API connects as the least-privileged application role.
DATABASE_URL=postgres://financas_app:financas-app-dev@localhost:5432/financas

# --- Auth secrets (OQ-100) ------------------------------------------------------
# PUBLIC dev-only placeholders, fine for CI and throwaway data. Before entering
# real data run `pnpm env:secrets`, which replaces them in your .env with fresh
# random values (and never touches a value that is already real).
JWT_SECRET=dev-only-jwt-secret-run-pnpm-env-secrets
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1ydW4tZW52LXNlY3JldHM=

# --- Logging (U2, OQ-110) ------------------------------------------------------
# LOG_LEVEL: error | warn | info | debug. Daily JSON files default to
# ~/.local/state/financas/logs (14 days).
LOG_LEVEL=info
# LOG_DIR=

# --- Migrations (N5) -----------------------------------------------------
# Owner role: used only by the migration tooling, never by the running API.
DATABASE_MIGRATION_URL=postgres://financas:financas-owner-dev@localhost:5432/financas

# --- E2E (Playwright) ---------------------------------------------------------
# A separate database, reset and migrated before every E2E run (tests/e2e/global-setup.ts).
DATABASE_TEST_URL=postgres://financas_app:financas-app-dev@localhost:5432/financas_test
DATABASE_TEST_MIGRATION_URL=postgres://financas:financas-owner-dev@localhost:5432/financas_test

# --- Backups (pnpm db:backup / db:restore / db:restore-drill, OQ-97) -------------
# Defaults: ~/.local/share/financas/backups, newest 30 kept.
# BACKUP_DIR=
# BACKUP_KEEP=30

# --- Docker Compose (Postgres) ---------------------------------------------
# Keep these in sync with the passwords/port in the URLs above.
DB_PORT=5432
DB_OWNER_PASSWORD=financas-owner-dev
DB_APP_PASSWORD=financas-app-dev
