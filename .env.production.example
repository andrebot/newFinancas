# Self-hosting settings (N10 S1, OQ-250) for compose.prod.yaml. Copy to
# .env.production on the server, fill in every value, keep it private
# (chmod 600). Runbook: docs/operations/self-hosting.md.

# --- Address and TLS -------------------------------------------------------
# The one name for LAN and Tailscale; links in emails point here too.
SITE_ADDRESS=financas.andrealmeida.tech
WEB_APP_URL=https://financas.andrealmeida.tech
# cloudflare (Let's Encrypt via DNS-01, the default) or internal (local trials).
TLS_MODE=cloudflare
# Cloudflare API token limited to Zone → DNS → Edit on andrealmeida.tech.
CLOUDFLARE_API_TOKEN=

# --- Secrets: generate each once, never change MFA_ENCRYPTION_KEY ---------------
# openssl rand -base64 48   (JWT_SECRET)
JWT_SECRET=
# openssl rand -base64 32   (MFA_ENCRYPTION_KEY: exactly 32 bytes)
MFA_ENCRYPTION_KEY=
# openssl rand -hex 24      (each database password)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# --- Where data lives on the host --------------------------------------------
# The encrypted dataset mounted into the LXC (mp0).
DB_DATA_DIR=/mnt/financas-db
# The API's log files (kept 14 days; the audit reconciliation reads them).
# The API runs as uid 1000 in its container: chown 1000:1000 this folder.
LOG_HOST_DIR=/opt/financas/logs
