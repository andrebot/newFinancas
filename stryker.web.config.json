{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "set per run by scripts/mutation.sh" },
  "mutate": ["set per run by scripts/mutation.sh"],
  "ignorePatterns": [
    "docs", ".superdesign", "storybook-static", "coverage", "reports", "test-results", "infra",
    "apps/web/storybook-static", "apps/web/coverage", "apps/web/dist"
  ],
  "coverageAnalysis": "off",
  "concurrency": 6,
  "timeoutMS": 30000,
  "reporters": ["json"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
